FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app \
    STOCKFISH_PATH=/usr/games/stockfish
RUN apt-get update \
    && apt-get install --no-install-recommends -y stockfish \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 chessmate \
    && useradd --uid 10001 --gid chessmate --create-home chessmate
WORKDIR /app
COPY src/backend/requirements.lock ./src/backend/requirements.lock
RUN pip install --no-cache-dir -r src/backend/requirements.lock
COPY --chown=chessmate:chessmate src/backend ./src/backend
COPY --chown=chessmate:chessmate scripts/import_exercises.py scripts/validate_exercises.py ./scripts/
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
