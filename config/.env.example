# Copy to config/.env, or let scripts/start.sh create it with a random password.
# This file deliberately contains no usable credentials.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX_PASSWORD

# Local-only by default. Set a LAN IP or 0.0.0.0 to reach from other devices.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Comma-separated exact browser origins, including the port. Add your LAN URL.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set true when serving over HTTPS through your own reverse proxy or VPN.
COOKIE_SECURE=false
# Optional authentication for installations exposed to untrusted users.
# Provision passwords with scripts/manage_accounts.py before enabling this.
SECURE_DEPLOYMENT=false
ALLOW_REGISTRATION=false

# External OpenAI-compatible inference server. Include /v1 if your server uses it.
# Example: http://192.168.1.50:8000/v1 on your DGX Spark.
# Leave endpoint/model empty to use verified deterministic coaching only.
LLM_BASE_URL=
LLM_MODEL=
# Leave empty for servers that do not require authentication.
LLM_API_KEY=
# Optional extra trusted CA for an HTTPS inference server, mounted read-only from config/certificates.
# Example: /app/config/certificates/local-root-ca.pem. Certificate verification stays enabled.
LLM_CA_BUNDLE=
LLM_TIMEOUT=35
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.2
# Optional provider-supported reasoning effort. Use none for reasoning models that
# spend the short fact-selection budget thinking instead of returning JSON.
# Leave blank to omit this parameter for servers that do not support it.
LLM_REASONING_EFFORT=

ENGINE_THREADS=1
ENGINE_HASH_MB=64
